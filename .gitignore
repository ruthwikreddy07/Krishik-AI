# =============================================================
# Krishik AI — .gitignore
# =============================================================

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
*.pyo
*.pyd
.Python
build/
develop-eggs/
eggs/
sdist/
wheels/
*.manifest
*.spec

# ── Virtual Environments ──────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Environment / Secrets (CRITICAL — contains API keys) ─────
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# ── Python version manager ────────────────────────────────────
.python-version

# ── Testing & Coverage ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── Jupyter Notebooks ────────────────────────────────────────
.ipynb_checkpoints/

# ── Uploaded images (user-generated runtime data) ─────────────
uploads/
backend/uploads/

# ── ML Models (large binaries — keep tracked selectively) ─────
ml_models/*
!ml_models/*.keras
!ml_models/*.h5
!ml_models/*.pkl
!ml_models/*.json

# ── Datasets (large files — download from Kaggle/sources) ─────
ml_training/datasets/*.csv
ml_training/datasets/PlantVillage/

# ── Logs & temp output ────────────────────────────────────────
*.log
check_results.txt

# ── Frontend (React / Vite) ───────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend/dist/

# ── OS Files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
ehthumbs_vista.db
*.lnk

# ── IDE / Editor ──────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
pyrightconfig.json

# ── PDF documents ─────────────────────────────────────────────
*.pdf

# ── Local scratch, debug, and test files ──────────────────────
scratch/
debug_override.py
test_ml_endpoints.py
presentation_cheat_sheet.md
check_datasets.py
test_api.py
krishik_ai_ppt_content.md
