# ============================================================
# Environment Configuration for Farmer Assistant Backend
# Copy this file to .env and fill in real values
# ============================================================

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=farmer_assistant

# --- Auth / Security ---
SECRET_KEY=your-secret-key-change-in-production

# --- External APIs ---
# Weather: Uses Open-Meteo (free, no API key needed)
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# --- ML Model File Paths ---
DISEASE_MODEL_PATH=ml_models/disease_detection.h5
CROP_RECOMMEND_MODEL_PATH=ml_models/crop_recommendation.pkl
YIELD_MODEL_PATH=ml_models/yield_prediction.pkl
PRICE_MODEL_PATH=ml_models/price_prediction.h5
FERTILIZER_MODEL_PATH=ml_models/fertilizer_recommendation.pkl

# --- File Uploads ---
UPLOAD_DIR=uploads/disease_images
